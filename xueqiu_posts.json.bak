      "view_count": 0,
      "is_retweet": true,
      "retweeted_status": {
        "id": 37352239,
        "author": "超级鹿鼎公",
        "text": "恒大要注意了啊，一年下来，恒大多元化的巨大开支要体现了，俺等着看笑话@管我财"
      }
