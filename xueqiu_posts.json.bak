    {
      "id": 235524215,
      "url": "https://xueqiu.com/8790885129/235524215",
      "created_at": "2022-11-16T12:39:50+08:00",
      "created_at_ms": 1668573590000,
      "author": {
        "id": 8790885129,
        "screen_name": "超级鹿鼎公"
      },
      "title": "",
      "text": "回复@九阳真经哼哼哈嘿: 呵呵，陕煤7块的时候，我满仓满融（当然这个满融是针对自己给出的最高125%仓位）//@九阳真经哼哼哈嘿:回复@超级鹿鼎公:看你们这些买神华，陕煤的现在算估值算分红算成长，算业绩，神华15，陕煤7块的时候无人问津，翻倍了算业绩估值分红的大V一个接一个来",
      "source": "雪球",
      "reply_count": 9,
      "retweet_count": 3,
      "like_count": 65,
      "view_count": 0,
      "is_retweet": true,
