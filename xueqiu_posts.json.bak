      "view_count": 0,
      "is_retweet": true,
      "retweeted_status": {
        "id": 358134918,
        "author": "超级鹿鼎公",
        "text": "$中国神华(SH601088)$ 神华的业绩也太扯淡了，煤价跌这么多，三季度利润居然只跌6%，前三季度才跌10%，国企的帐太扯淡了"
      }
    },
    {
      "id": 358141705,
      "url": "https://xueqiu.com/8790885129/358141705",
      "created_at": "2025-10-24T21:23:56+08:00",
      "created_at_ms": 1761312236000,
      "author": {
