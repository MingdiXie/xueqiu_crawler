      "retweeted_status": {
        "id": 218204423,
        "author": "超级鹿鼎公",
        "text": "火电做绿电抢的是自己的火电生意，绿电却靠火电输血，一堆债务，加上之前巨额亏损消耗资本金，1个都很烂的生意+一个也不算好的生意（需要大量资本），加一起却成了很多人眼里的好生意"
      }
    },
